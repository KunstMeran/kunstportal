# =====================================================
# Kunstmeran App - .gitignore
# Hetzner Deployment
# =====================================================

# Environment variables
.env
.env.local
.env.production

# Node modules
node_modules/

# Logs
*.log
npm-debug.log*

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo

# Backup files
*.backup
*~

# Archive folder (legacy files, not needed in repo)
archive/

# Local data (not in repo)
data/

# DATEV Exporte (lokale Daten, sensibel)
DATEV Exporte/

# Local scripts (VBS, etc.)
scripts/

# Excel temporaere Dateien
~$*.xlsx
~$*.xls

# OneDrive temporaere Dateien
~*

# Build output
dist/
build/

# Claude Code
.claude/

# Migration files (temporary, contains sensitive data)
*.zip
supabase_data.sql
supabase/
